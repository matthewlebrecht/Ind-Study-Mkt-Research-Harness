# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
# Real environment variables override anything set here.
# Read by core/config.py -- get_key() for optional keys, require_key() for mandatory ones.

# Brave Search API. Required by the search-backed harnesses:
# H-EXECID-01 (search fallback), H-EXECVOICE-01 (discovery), H-FIRSTPARTY-01.
# https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=

# FMCSA QCMobile web key. Optional -- H-FMCSA-01 falls back to HTML scraping without it,
# but prefers the JSON API when it is present. harnesses/h_fmcsa_01/source.py
FMCSA_WEBKEY=

# Anthropic API key. Optional -- only for the not-yet-implemented LLM job-posting
# classifier. harnesses/h_jobpost_01/classifier.py
ANTHROPIC_API_KEY=
